# Complete reference for every environment variable supported by this project.
#
# For fully manual setup, copy this file to `.env.local` and fill in real values.
# The automated setup intentionally splits the effective configuration:
#   - Stripe Projects writes project-managed values to `.env`.
#   - `npm run stripe:setup-local` writes local Stripe credentials and overrides
#     to `.env.local`.
# Next.js loads both files and gives `.env.local` precedence when a key is present
# in both. Both files are gitignored; do not commit real credentials.
#
# All inference runs through OpenAI; ScrapeCreators provides live Marketplace
# search data.

# --- OpenAI ------------------------------------------------------------------
# Used by app/api/chat/route.ts. If OPENAI_API_KEY is unset, the chat route
# falls back to deterministic stub responses so local dev still runs.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-sol

# --- ScrapeCreators (live Facebook Marketplace data provider) ---------------
# Used by app/api/marketplace/{search,item,location}/route.ts.
# Without this key the marketplace routes return 503 and the search agent falls
# back to seeded listings (lib/data.ts).
SCRAPECREATORS_API_KEY=your-scrapecreators-api-key

# ===========================================================================
# RunPod backend (runpod/) — BrightData scraping + Qwen2.5-VL defect detection
# ===========================================================================

# --- RunPod (serverless GPU/CPU host for the flash endpoints) ---------------
# Used by `flash dev` / `flash deploy`. Alternatively run `flash login` once
# (browser auth) instead of setting this. Required to run the scraper/vision
# endpoints on RunPod; NOT needed for the offline demo (`python -m runpod.demo`).
RUNPOD_API_KEY=your-runpod-api-key

# Public HTTPS base URLs for deployed RunPod Flash endpoints, used by the Next.js
# API proxy routes. If both endpoints share one base URL, set RUNPOD_BACKEND_BASE_URL.
# The app will call:
#   POST {RUNPOD_BACKEND_BASE_URL}/scraper_ep/search
#   POST {RUNPOD_BACKEND_BASE_URL}/scraper_ep/listing
#   POST {RUNPOD_BACKEND_BASE_URL}/vision_ep/defects
RUNPOD_BACKEND_BASE_URL=
# Or configure them separately:
RUNPOD_SCRAPER_BASE_URL=
RUNPOD_VISION_BASE_URL=

# --- BrightData Web Unlocker (live Facebook Marketplace scraping) -----------
# Used by runpod/lib/brightdata.py (scraper endpoint). We use the Web Unlocker
# Web Access API (no paid Marketplace dataset): it returns the rendered HTML for
# a listing/search URL and we parse the embedded JSON. Without BRIGHTDATA_API_TOKEN
# the scraper falls back to seeded iPhone fixtures (runpod/fixtures/), so dev and
# the demo still run keyless.
BRIGHTDATA_API_TOKEN=your-brightdata-api-token
# Your Web Unlocker zone name from the BrightData dashboard (Proxies & Scraping
# -> Web Unlocker). Defaults to "web_unlocker1" if unset.
BRIGHTDATA_WEB_UNLOCKER_ZONE=web_unlocker1

# ===========================================================================
# SOLID trusted meetup payments — Stripe Connect test mode
# ===========================================================================
#
# For automated local setup, the Stripe values in this section are generated in
# `.env.local` by `npm run stripe:setup-local`; the placeholders remain here to
# document the complete configuration and support fully manual setup.

# Server-only Stripe test secret. Never expose this through NEXT_PUBLIC_*.
STRIPE_SECRET_KEY=sk_test_replace_me

# Browser-safe Stripe test publishable key used by Steven's checkout UI.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Signing secret printed by `stripe listen` locally, or configured for the
# deployed `/api/stripe/webhook` endpoint.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Public application origin used in Stripe Connect onboarding return URLs.
APP_BASE_URL=http://localhost:3000

# Auth0 — normally provisioned into `.env` with Stripe Projects
# (`stripe projects add auth0/client`), or configured manually in `.env.local`
# using a Regular Web Application from the Auth0 Dashboard.
# Allowed callback URL: http://localhost:3000/auth/callback
# Allowed logout URL and web origin: http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Generate with: openssl rand -hex 32
AUTH0_SECRET=

# Secret used to derive scoped buyer/seller deal tokens. Use a random value.
PAYMENT_TOKEN_SECRET=replace-with-at-least-32-random-bytes

# Local hackathon persistence. Omit to use `.data/solid-payments.sqlite`.
PAYMENTS_DB_PATH=.data/solid-payments.sqlite

# Protects the timeout-refund scheduler endpoint.
CRON_SECRET=replace-with-a-random-scheduler-secret
